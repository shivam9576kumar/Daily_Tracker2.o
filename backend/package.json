{
  "name": "@dsa-planner/backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run build --prefix ../shared && prisma generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-scheduled-keys": "tsx scripts/backfillScheduledDateKeys.ts",
    "backfill:platform": "tsx scripts/backfillPlatform.ts",
    "data:validate-striver-gfg": "tsx scripts/validateStriverGfgMapping.ts",
    "data:audit-striver-gfg": "tsx scripts/auditStriverGfgMappings.ts",
    "data:verify-gfg-urls": "tsx scripts/verifyGfgUrlsHttp.ts",
    "data:revert-unsafe-striver-gfg": "tsx scripts/revertUnsafeStriverGfgLinks.ts",
    "data:revert-unsafe-striver-gfg:apply": "tsx scripts/revertUnsafeStriverGfgLinks.ts --apply",
    "data:backfill-striver-gfg:dry-run": "tsx scripts/backfillStriverGfgLinks.ts --dry-run",
    "data:backfill-striver-gfg:apply": "tsx scripts/backfillStriverGfgLinks.ts",
    "data:backfill-striver-gfg-v2": "tsx scripts/backfillStriverGfgUrls.ts",
    "typecheck": "tsc --noEmit",
    "verify:todo": "tsx scripts/verifyTodoFeature.ts",
    "cp31:convert": "tsx scripts/convertCp31Input.ts",
    "cp31:validate": "tsx scripts/validateCp31Sheet.ts",
    "verify:potd-toggle": "tsx scripts/verifyPotdToggle.ts",
    "verify:cp31": "tsx scripts/verifyCp31.ts",
    "verify:part-d": "tsx scripts/verifyPartD.ts",
    "verify:daily-challenges": "tsx scripts/verifyDailyChallengesE2E.ts",
    "fuzz:coins": "tsx scripts/fuzzCoinInvariant.ts",
    "verify:all": "npm run cp31:validate && npm run verify:todo && npm run verify:potd-toggle && npm run verify:cp31 && npm run verify:daily-challenges && npm run fuzz:coins -- --steps=300",
    "practice:import": "tsx scripts/importPracticeCatalog.ts"
  },
  "dependencies": {
    "@dsa-planner/shared": "*",
    "@google/generative-ai": "^0.24.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "^6.4.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
