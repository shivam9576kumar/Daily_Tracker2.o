# ─── Database ───
# Pooled database connection URL.
# If using Supabase transaction pooler (port 6543):
# DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=10&pool_timeout=20"
# If using session pooler or direct (port 5432):
# DATABASE_URL="postgresql://user:password@host:5432/postgres?connection_limit=10&pool_timeout=20"
DATABASE_URL="postgresql://username:password@localhost:5432/dsa_study_planner?connection_limit=10&pool_timeout=20"

# Direct connection URL used by Prisma migrations (always direct, port 5432, non-pooled).
# Required in production for migrations to avoid pgbouncer transaction mode issues.
DIRECT_URL="postgresql://username:password@localhost:5432/dsa_study_planner"

# ─── Server ───
PORT=3001
NODE_ENV=development
DEFAULT_TIMEZONE=Asia/Kolkata

# ─── JWT ───
# Required in production: must be a random string of at least 32 characters.
# In development, defaults to 'dev-secret-change-me' if unset.
JWT_SECRET=your-random-secret-key-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# ─── Google OAuth ───
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── Google Gemini AI ───
# Both GEMINI_API_KEY and GEMINI_MODEL are required to enable AI features.
# If either is missing, the server starts normally but degrades gracefully (AI disabled, manual wizard available).
GEMINI_API_KEY=your-gemini-api-key
# Choose a model reported by the Gemini ListModels API (e.g. gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallback models
GEMINI_MODEL_FALLBACKS=

# ─── CORS ───
# In production, must be set to your deployed frontend origin(s), comma-separated.
# Server refuses to boot with localhost default when NODE_ENV=production.
FRONTEND_URL=http://localhost:5173

# ─── Scheduled Maintenance Cron ───
# Bearer secret required to invoke GET /api/cron/daily from Vercel Cron or an external scheduler.
CRON_SECRET=

